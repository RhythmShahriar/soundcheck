<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Site}} · website check · {{.Date}}</title>
<style>
:root {
  --accent: {{.Accent}};
  --bg: #FFFFFF; --text: #1C1917; --muted: #6B7280; --line: #E7E5E4; --soft: #F7F7F5;
  --bad: #DC2626; --warn: #EA580C; --note: #A16207; --good: #059669;
  --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 var(--sans); }
.wrap { max-width: 860px; margin: 0 auto; padding: 0 20px 64px; }
header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 28px 0 20px; border-bottom: 3px solid var(--accent); flex-wrap: wrap; }
.agency { display: flex; align-items: center; gap: 14px; font-weight: 700; font-size: 18px; }
.agency img { max-height: 48px; max-width: 200px; }
.meta { color: var(--muted); font-size: 14px; text-align: right; }
.hero { padding: 36px 0 8px; }
.eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; font-size: 12px; }
h1 { font-size: clamp(28px, 5vw, 40px); line-height: 1.15; letter-spacing: -.02em; margin: 8px 0 10px; }
.lead { color: var(--muted); margin: 0; font-size: 17px; }
.counts { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin: 28px 0 8px; }
.count { border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
.count b { display: block; font-size: 28px; line-height: 1.1; color: var(--c); }
.count span { color: var(--muted); font-size: 14px; }
.count.zero b { color: var(--muted); }
h2 { font-size: 20px; margin: 40px 0 12px; }
ul.checked { margin: 0; padding-left: 20px; }
ul.checked li { margin: 4px 0; }
.item { border: 1px solid var(--line); border-left: 4px solid var(--c); border-radius: 12px; padding: 14px 18px; margin-bottom: 12px; break-inside: avoid; }
.item .label { display: inline-block; font-size: 12px; font-weight: 700; color: #fff; background: var(--c); border-radius: 6px; padding: 1px 8px; }
.item h3 { margin: 6px 0 2px; font-size: 17px; overflow-wrap: anywhere; }
.item p { margin: 0; color: var(--muted); font-size: 14px; overflow-wrap: anywhere; }
.pics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }
.pics figure { margin: 0; }
.pics img { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 8px; display: block; }
.pics figcaption { color: var(--muted); font-size: 12px; margin-top: 4px; text-transform: uppercase; letter-spacing: .06em; }
.more { color: var(--muted); font-size: 14px; }
.t-bad { --c: var(--bad); } .t-warn { --c: var(--warn); } .t-note { --c: var(--note); } .t-good { --c: var(--good); }
footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
@media (max-width: 560px) { .pics { grid-template-columns: 1fr; } .meta { text-align: left; } }
@media print { .wrap { max-width: none; } }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="agency">{{if .Logo}}<img src="{{.Logo}}" alt="{{.Agency}}">{{end}}<span>{{.Agency}}</span></div>
    <div class="meta">Website check for <b>{{.Site}}</b><br>{{.Date}}</div>
  </header>

  <section class="hero t-{{.Tone}}">
    <div class="eyebrow">Summary</div>
    <h1>{{.Title}}</h1>
    <p class="lead">{{.Lead}}</p>
    <div class="counts">{{range .Counts}}<div class="count t-{{.Tone}}{{if eq .N 0}} zero{{end}}"><b>{{.N}}</b><span>{{.Label}}</span></div>{{end}}</div>
  </section>

  <h2>What we checked</h2>
  <ul class="checked">{{range .Checked}}<li>{{.}}</li>{{end}}</ul>

  {{if .Items}}
  <h2>What we found</h2>
  {{range .Items}}
  <div class="item t-{{.Tone}}">
    <span class="label">{{.Label}}</span>
    <h3>{{.Title}}</h3>
    <p>{{.Where}}{{if .Change}} · {{.Change}}{{end}}</p>
    {{if .Before}}<div class="pics"><figure><img src="{{.Before}}" alt="Before"><figcaption>Before</figcaption></figure><figure><img src="{{.After}}" alt="After"><figcaption>After</figcaption></figure></div>{{end}}
  </div>
  {{end}}
  {{if .More}}<p class="more">And {{.More}} more, which we're looking at too.</p>{{end}}
  {{end}}

  {{if .Fixed}}
  <h2>Fixed since last time</h2>
  <ul class="checked">{{range .Fixed}}<li>{{.}}</li>{{end}}</ul>
  {{if .MoreFixed}}<p class="more">And {{.MoreFixed}} more.</p>{{end}}
  {{end}}

  <footer><span>Prepared by {{.Agency}}{{if .Contact}} · {{.Contact}}{{end}}</span><span>Checked with rhythm soundcheck</span></footer>
</div>
</body>
</html>
