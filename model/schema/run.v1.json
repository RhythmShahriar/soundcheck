{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RhythmShahriar/soundcheck/blob/main/model/schema/run.v1.json",
  "title": "Soundcheck run",
  "description": "One check of a site: run --json, snapshot --json, report --json on a run and run.json in a snapshot or run folder. summary and groups are in the command output only. run.json has schema rhythm-soundcheck/v1+jsonl, an empty pages list, pages_file and page_count: the pages are in pages_file next to it, one page object per line. A run.json from an older version has schema rhythm-soundcheck/v1 and its pages inline. Fields are only added within rhythm-soundcheck/v1.",
  "type": "object",
  "required": ["schema", "kind", "tool", "version", "target", "started", "duration_ms", "options", "pages", "warnings"],
  "properties": {
    "schema": {"enum": ["rhythm-soundcheck/v1", "rhythm-soundcheck/v1+jsonl"], "description": "rhythm-soundcheck/v1 in command output; rhythm-soundcheck/v1+jsonl in run.json, whose pages are in pages_file."},
    "kind": {"const": "run"},
    "tool": {"type": "string"},
    "version": {"type": "string"},
    "target": {"type": "string"},
    "name": {"type": "string", "description": "The snapshot's name, for a snapshot."},
    "started": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "number"},
    "options": {"$ref": "#/$defs/options"},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}, "description": "Issues of the whole site, such as broken links."},
    "skipped": {"type": "object", "additionalProperties": {"type": "integer"}, "description": "URLs discovery left out, by reason."},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "cache": {"type": "object", "additionalProperties": {"type": "string"}},
    "echo": {"type": "array", "items": {"$ref": "#/$defs/echoAction"}, "description": "Messages each flow made the site send."},
    "interrupted": {"type": "boolean", "description": "Stopped before it finished; left out when false."},
    "key_flows": {
      "type": "object",
      "description": "Key flows (run by keyboard only) that ran and that were skipped, when the keyboard module ran.",
      "required": ["run"],
      "properties": {
        "run": {"type": "integer", "minimum": 0},
        "skipped": {"type": "array", "items": {"$ref": "#/$defs/skippedFlow"}}
      }
    },
    "eaa": {"$ref": "#/$defs/eaa"},
    "pages_file": {"type": "string", "description": "In run.json only: the file next to it that holds the pages, one per line (pages.jsonl or pages.1.jsonl)."},
    "page_count": {"type": "integer", "minimum": 0, "description": "In run.json only: how many lines pages_file has."},
    "summary": {"$ref": "#/$defs/summary"},
    "groups": {
      "type": "array",
      "description": "Every issue once, with all the pages that have it, most serious first.",
      "items": {
        "type": "object",
        "required": ["key", "check", "level", "title", "pages"],
        "properties": {
          "key": {"type": "string"},
          "check": {"type": "string"},
          "level": {"$ref": "#/$defs/level"},
          "title": {"type": "string"},
          "pages": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "level": {"enum": ["error", "warning", "notice"]},
    "eaa": {
      "type": "object",
      "description": "The accessibility summary of an --eaa run, in command output only. Counts are of the WCAG criteria of the version run; no_failures_found means these tests found nothing, not that the criterion is met.",
      "required": ["wcag", "en301549", "axe", "criteria", "keyboard", "open", "interrupted", "evidence_note"],
      "properties": {
        "wcag": {"type": "string", "description": "2.1 or 2.2."},
        "en301549": {"type": "string", "description": "The matching EN 301 549 version, such as V3.2.1."},
        "axe": {"type": "string", "description": "axe-core's version."},
        "criteria": {
          "type": "object",
          "required": ["failed", "no_failures_found", "not_tested"],
          "properties": {
            "failed": {"type": ["array", "null"], "items": {"$ref": "#/$defs/criterionCount"}},
            "no_failures_found": {"type": ["array", "null"], "items": {"type": "string"}},
            "not_tested": {"type": ["array", "null"], "items": {"type": "string"}}
          }
        },
        "keyboard": {
          "type": "object",
          "required": ["pages_walked", "widgets_tested", "flows_run"],
          "properties": {
            "pages_walked": {"type": "integer", "minimum": 0},
            "widgets_tested": {"type": "integer", "minimum": 0},
            "flows_run": {"type": "integer", "minimum": 0},
            "flows_skipped": {"type": "array", "items": {"$ref": "#/$defs/skippedFlow"}}
          }
        },
        "not_audited": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "module", "status"],
            "properties": {
              "path": {"type": "string"},
              "module": {"type": "string"},
              "status": {"$ref": "#/$defs/auditStatus"},
              "reason": {"type": "string"}
            }
          }
        },
        "open": {"type": "integer", "minimum": 0},
        "interrupted": {"type": "boolean"},
        "evidence_note": {"type": "string"}
      }
    },
    "criterionCount": {
      "type": "object",
      "required": ["id", "issues", "pages"],
      "properties": {
        "id": {"type": "string"},
        "issues": {"type": "integer", "minimum": 0},
        "pages": {"type": "integer", "minimum": 0}
      }
    },
    "skippedFlow": {
      "type": "object",
      "required": ["file", "reason"],
      "properties": {"file": {"type": "string"}, "reason": {"type": "string"}}
    },
    "auditStatus": {"enum": ["ok", "capped", "timeout", "error", "skipped"]},
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "notices", "verdict"],
      "properties": {
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "notices": {"type": "integer", "minimum": 0},
        "verdict": {"enum": ["clean", "warnings", "errors", "interrupted"], "description": "interrupted when the run was stopped, else errors, warnings or clean (notices only, or nothing)."},
        "failed": {"type": "boolean", "description": "Whether the run fails at the --fail-on threshold. Left out without one."}
      }
    },
    "options": {
      "type": "object",
      "required": ["viewports", "levels", "modules", "limit"],
      "properties": {
        "viewports": {"type": ["array", "null"], "items": {"type": "string"}},
        "levels": {"type": ["array", "null"], "items": {"type": "string"}},
        "modules": {"type": ["array", "null"], "items": {"type": "string"}},
        "limit": {"type": "integer"},
        "logged_in": {"type": "boolean"},
        "echo": {"type": "boolean"},
        "echo_mode": {"type": "string"},
        "echo_url": {"type": "string"},
        "engine": {"enum": ["firefox", "webkit"], "description": "The browser engine the pages were captured in. Absent for Chrome."},
        "eaa": {"type": "boolean", "description": "The run was made with --eaa."},
        "wcag": {"enum": ["2.0", "2.1", "2.2"], "description": "The WCAG version of the accessibility checks. Absent before 1.3, which used 2.0."},
        "a11y": {
          "type": "object",
          "required": ["axe", "axe_sha256", "tags", "rules", "max_elements"],
          "properties": {
            "axe": {"type": "string"},
            "axe_sha256": {"type": "string"},
            "tags": {"type": ["array", "null"], "items": {"type": "string"}},
            "rules": {"type": ["array", "null"], "items": {"type": "string"}},
            "max_elements": {"type": "integer", "minimum": 0}
          }
        },
        "keyboard": {
          "type": "object",
          "required": ["max_tabs", "widgets", "trap_after", "skip_link"],
          "properties": {
            "max_tabs": {"type": "integer", "minimum": 0},
            "widgets": {"type": "integer", "minimum": 0},
            "trap_after": {"type": "integer", "minimum": 0},
            "skip_link": {"type": "string"}
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["check", "level", "title", "key"],
      "properties": {
        "check": {"type": "string"},
        "level": {"$ref": "#/$defs/level"},
        "title": {"type": "string"},
        "detail": {"type": "string"},
        "source": {"type": "string"},
        "fix": {"type": "string"},
        "key": {"type": "string", "description": "check|title|source: the issue's identity across runs."},
        "pages": {"type": "array", "items": {"type": "string"}},
        "wcag": {"type": "array", "items": {"type": "string"}, "description": "WCAG success criteria the issue fails, such as 2.1.2."},
        "en301549": {"type": "array", "items": {"type": "string"}, "description": "EN 301 549 clauses: 9. plus each WCAG criterion."},
        "impact": {"enum": ["critical", "serious", "moderate", "minor"]},
        "focus_path": {"type": "array", "items": {"type": "string"}, "description": "Selectors of the last keyboard focus stops before the problem."}
      }
    },
    "request": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string"},
        "method": {"type": "string"},
        "type": {"type": "string"},
        "status": {"type": "integer"},
        "error": {"type": "string"}
      }
    },
    "resource": {
      "type": "object",
      "required": ["url", "type", "status", "bytes"],
      "properties": {
        "url": {"type": "string"},
        "type": {"type": "string"},
        "status": {"type": "integer"},
        "bytes": {"type": "integer"},
        "protocol": {"type": "string"},
        "encoding": {"type": "string"},
        "cache": {"type": "string"},
        "mime": {"type": "string"},
        "unused": {"type": "integer"}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["ttfb_ms", "cls", "tbt_ms", "load_ms", "bytes", "requests"],
      "properties": {
        "ttfb_ms": {"type": "number"},
        "fcp_ms": {"type": "number"},
        "lcp_ms": {"type": "number"},
        "cls": {"type": "number"},
        "tbt_ms": {"type": "number"},
        "load_ms": {"type": "number"},
        "bytes": {"type": "integer"},
        "requests": {"type": "integer"}
      }
    },
    "rect": {
      "type": "object",
      "required": ["X", "Y", "W", "H"],
      "properties": {"X": {"type": "integer"}, "Y": {"type": "integer"}, "W": {"type": "integer"}, "H": {"type": "integer"}}
    },
    "shot": {
      "type": "object",
      "required": ["file", "width", "height"],
      "properties": {
        "file": {"type": "string", "description": "Relative to the run's folder."},
        "second": {"type": "string"},
        "width": {"type": "integer"},
        "height": {"type": "integer"},
        "dynamic": {"type": "array", "items": {"$ref": "#/$defs/rect"}},
        "masked": {"type": "array", "items": {"$ref": "#/$defs/rect"}}
      }
    },
    "interaction": {
      "type": "object",
      "required": ["kind", "selector", "label", "outcome"],
      "properties": {
        "kind": {"type": "string"},
        "selector": {"type": "string"},
        "label": {"type": "string"},
        "outcome": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "echoAction": {
      "type": "object",
      "required": ["action", "label", "kind", "page", "messages"],
      "properties": {
        "action": {"type": "string"},
        "label": {"type": "string"},
        "kind": {"enum": ["form", "flow"]},
        "page": {"type": "string"},
        "messages": {"type": ["array", "null"], "items": {"type": "object", "description": "A message in Echo's own format."}}
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "url", "path", "status", "text_length", "metrics", "duration_ms"],
      "properties": {
        "id": {"type": "string"},
        "url": {"type": "string"},
        "path": {"type": "string"},
        "group": {"type": "string"},
        "final_url": {"type": "string"},
        "status": {"type": "integer"},
        "redirects": {"type": "array", "items": {"type": "string"}},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "title": {"type": "string"},
        "robots": {"type": "string"},
        "text_hash": {"type": "string"},
        "text_length": {"type": "integer"},
        "console": {"type": "array", "items": {"type": "string"}},
        "failed": {"type": "array", "items": {"$ref": "#/$defs/request"}},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "links": {"type": "array", "items": {"type": "string"}},
        "metrics": {"$ref": "#/$defs/metrics"},
        "shots": {"type": "object", "additionalProperties": {"$ref": "#/$defs/shot"}, "description": "By viewport: desktop, mobile."},
        "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
        "cache": {"type": "object", "additionalProperties": {"type": "string"}},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "error": {"type": "string", "description": "Why the page couldn't be visited."},
        "duration_ms": {"type": "number"},
        "echo": {"type": "array", "items": {"$ref": "#/$defs/echoAction"}},
        "audits": {
          "type": "object",
          "description": "By module (a11y, keyboard): whether its audit of the page finished.",
          "additionalProperties": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"$ref": "#/$defs/auditStatus"},
              "reason": {"type": "string"},
              "frames": {"type": "array", "items": {"type": "string"}},
              "capped_rules": {"type": "object", "additionalProperties": {"type": "integer"}}
            }
          }
        },
        "keyboard": {
          "type": "object",
          "description": "The keyboard walk of the page; its trace is in evidence.",
          "required": ["stops", "wrapped"],
          "properties": {
            "stops": {"type": "integer", "minimum": 0},
            "wrapped": {"type": "boolean"},
            "capped": {"type": "boolean"},
            "skip_link": {"type": "string"},
            "widgets": {"type": "integer", "minimum": 0},
            "frames": {"type": "array", "items": {"type": "string"}},
            "evidence": {"type": "string", "description": "The trace file, relative to the run's folder."},
            "crops": {"type": "object", "additionalProperties": {"type": "string"}},
            "widget_kinds": {"type": "array", "items": {"type": "string"}},
            "ms": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
