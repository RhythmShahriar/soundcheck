{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RhythmShahriar/soundcheck/blob/main/model/schema/statement.v1.json",
  "title": "Soundcheck accessibility statement draft",
  "description": "rhythm soundcheck statement --json: the draft of an accessibility statement from an --eaa run, as data. It is evidence for the owner's own statement: status is always null because choosing it is the owner's decision. Fields are only added within rhythm-soundcheck/statement/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool", "version", "date", "layout", "wcag", "en301549", "standard", "status", "evidence_note", "todo", "website", "owner", "pages", "private_pages", "checked", "axe", "axe_rules", "own_checks", "totals", "criteria", "known_issues", "ignored", "not_audited", "frames", "keyboard", "notes", "limits"],
  "properties": {
    "schema": {"const": "rhythm-soundcheck/statement/v1"},
    "tool": {"const": "rhythm-soundcheck"},
    "version": {"type": "string", "description": "Soundcheck's version."},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The day the draft was written."},
    "layout": {"enum": ["model", "service"], "description": "model: the model statement of Implementing Decision (EU) 2018/1523. service: the service information of the European Accessibility Act, Annex V."},
    "wcag": {"enum": ["2.1", "2.2"]},
    "en301549": {"type": "string", "description": "The EN 301 549 version whose clause 9 matches the WCAG version, such as V3.2.1."},
    "standard": {"type": "string", "description": "What the criteria are from, such as WCAG 2.1 level AA / EN 301 549 V3.2.1."},
    "status": {"type": "null", "description": "Always null. Soundcheck never chooses a status; the owner does after their own review."},
    "evidence_note": {"type": "string", "description": "The fixed note said with every accessibility result."},
    "todo": {"type": "integer", "minimum": 0, "description": "[TO DO] markers the Markdown and HTML drafts hold."},
    "website": {"type": "string", "description": "statement.website, the public address. The run's own host never appears."},
    "owner": {"$ref": "#/$defs/owner"},
    "pages": {"type": "integer", "minimum": 0, "description": "Pages checked."},
    "private_pages": {"type": "integer", "minimum": 0, "description": "Pages checked logged in and left out of every list (statement.list_private_paths is off)."},
    "checked": {"type": "array", "items": {"type": "string"}, "description": "Paths of the pages checked, sorted, without query strings and with tokens masked."},
    "axe": {"type": "string", "description": "axe-core's version."},
    "axe_rules": {"type": "integer", "minimum": 0, "description": "axe-core rules the run applied."},
    "own_checks": {"type": "integer", "minimum": 0, "description": "Soundcheck's own checks that ran with axe-core's rules and test a WCAG criterion, such as reflow and placeholder-label. Advisory checks are left out."},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "failed", "not_tested"],
      "description": "What the status sentence says: the tests' results, whatever the owner recorded.",
      "properties": {
        "criteria": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "not_tested": {"type": "integer", "minimum": 0}
      }
    },
    "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}, "description": "Every A and AA criterion of the WCAG version, in number order."},
    "known_issues": {"type": "array", "items": {"$ref": "#/$defs/known"}},
    "ignored": {"type": "array", "items": {"$ref": "#/$defs/ignored"}, "description": "Problems ignore rules or accepts left out of the results, with the owner's reason. They still count against their criteria."},
    "not_audited": {"type": "array", "items": {"$ref": "#/$defs/notAudited"}},
    "frames": {"type": "array", "items": {"type": "string"}, "description": "Hosts of frames the audits didn't enter."},
    "keyboard": {"$ref": "#/$defs/keyboard"},
    "notes": {"type": "array", "items": {"type": "string"}, "description": "Facts of the run that limit the draft, such as TLS certificate not verified for this run."},
    "limits": {"type": "array", "items": {"type": "string"}, "description": "The fixed sentences on what the tests can and can't tell."}
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email", "scope"],
      "description": "The statement: block of the config file.",
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "address": {"type": "string"},
        "response_days": {"type": "integer", "minimum": 1},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "enforcement": {"type": "string"},
        "scope": {"type": "array", "items": {"type": "string"}},
        "service": {"type": "string"}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "principle", "en301549", "coverage", "tested_by", "how_tested", "result", "tests", "text", "issues", "pages", "paths", "manual"],
      "properties": {
        "id": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "title": {"type": "string"},
        "level": {"enum": ["A", "AA"]},
        "principle": {"enum": ["Perceivable", "Operable", "Understandable", "Robust"]},
        "en301549": {"type": "string", "description": "The EN 301 549 clause: 9 plus the WCAG number."},
        "coverage": {"enum": ["partly", "none"]},
        "tested_by": {"type": "array", "items": {"type": "string"}, "description": "Soundcheck's checks and axe:<rule> for the axe rules that test it."},
        "how_tested": {"type": "string"},
        "result": {"enum": ["failures_found", "no_failures_found", "not_tested", "manual"]},
        "tests": {"enum": ["failures_found", "no_failures_found", "not_tested"], "description": "What the tests found, before a manual entry."},
        "text": {"type": "string", "description": "The result as the criteria table writes it."},
        "issues": {"type": "integer", "minimum": 0},
        "pages": {"type": "integer", "minimum": 0},
        "paths": {"type": "array", "items": {"type": "string"}, "description": "Up to 3 pages with a problem, when they may be listed."},
        "manual": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["result", "by", "date"],
          "properties": {
            "result": {"enum": ["failures found", "no failures found", "not checked"]},
            "by": {"type": "string"},
            "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        }
      }
    },
    "known": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "title", "text"],
      "properties": {
        "criterion": {"type": "string"},
        "title": {"type": "string"},
        "text": {"type": "string"},
        "until": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "ignored": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "check", "pages", "reason"],
      "properties": {
        "criteria": {"type": "array", "items": {"type": "string"}},
        "check": {"type": "string"},
        "pages": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },
    "notAudited": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "module", "status"],
      "properties": {
        "path": {"type": "string", "description": "Empty for a page behind a login that isn't listed."},
        "module": {"type": "string"},
        "status": {"enum": ["timeout", "error", "skipped"]},
        "reason": {"type": "string"}
      }
    },
    "keyboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages_walked", "widgets_tested", "flows_run", "flows_skipped"],
      "properties": {
        "pages_walked": {"type": "integer", "minimum": 0},
        "widgets_tested": {"type": "integer", "minimum": 0},
        "flows_run": {"type": "integer", "minimum": 0},
        "flows_skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "reason"],
            "properties": {"file": {"type": "string"}, "reason": {"type": "string"}}
          }
        }
      }
    }
  }
}
