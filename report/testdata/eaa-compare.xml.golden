  <testsuite name="soundcheck.broke" tests="1" failures="1" errors="0" skipped="0" timestamp="2026-10-26T09:00:00Z">
    <testcase name="Keyboard focus is trapped: Card number" classname="keyboard.trap">
      <failure message="BROKE: Keyboard focus is trapped: Card number" type="broke">where: /checkout/&#xA;source: #card-element &gt; div:nth-of-type(1)&#xA;detail: Tab and Shift+Tab kept focus here for 4 presses; 3 focusable elements after it can&#39;t be reached.&#xA;fix: Let Tab move on from the field.</failure>
    </testcase>
  </testsuite>
  <testsuite name="soundcheck.new" tests="1" failures="1" errors="0" skipped="0" timestamp="2026-10-26T09:00:00Z">
